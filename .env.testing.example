APP_ENV=testing
# .env.testing replaces .env entirely during tests, so APP_KEY must be set here too.
# Generate one with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=true

# The test suite runs against a real PostgreSQL database so it exercises the same
# driver as production. The database name must end in "_testing" — tests/TestCase.php
# refuses to run otherwise, so a misconfiguration can never wipe your dev database.
#
#   createdb task_app_backend_testing
#
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=task_app_backend_testing
DB_USERNAME=your_username
DB_PASSWORD=your_password
